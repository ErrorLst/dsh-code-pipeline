{
  "name": "@dsh-external/dsh-code-pipeline",
  "version": "0.6.1",
  "description": "DSH bundle 插件：为 code-pipeline 预设注入 plan/impl/review 三阶段子代理工具，模型、并发上限与墙钟预算可在设置页实时配置。",
  "homepage": "https://github.com/ErrorLst/dsh-code-pipeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErrorLst/dsh-code-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/ErrorLst/dsh-code-pipeline/issues"
  },
  "keywords": [
    "dsh",
    "code-pipeline",
    "subagent",
    "pipeline",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "preset"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.7-alpha.1"
  },
  "scripts": {
    "test": "node test/watchdog.smoke.mjs",
    "build:preset": "node scripts/build-preset.mjs",
    "check:preset": "node scripts/check-preset-upstream.mjs",
    "verify": "node test/watchdog.smoke.mjs && node scripts/check-preset-upstream.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/code-pipeline/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
